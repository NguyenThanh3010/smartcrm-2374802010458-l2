# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcrm
DB_USER=your_postgres_username
DB_PASSWORD=your_postgres_password

# Backend
APP_PORT=3000

# Local development authentication - change before use
AUTH_USERNAME=admin
AUTH_PASSWORD=change_this_local_password
AUTH_TOKEN_SECRET=replace_with_a_random_secret_at_least_32_characters

# Frontend
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://localhost:3000
