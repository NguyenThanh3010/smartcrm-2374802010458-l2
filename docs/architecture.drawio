        <mxCell id="xu6kovZ2p-w6JD-nPXKa-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span&gt;Gọi &lt;/span&gt;&lt;span&gt;qua &lt;/span&gt;&lt;span&gt;giao &lt;/span&gt;&lt;span&gt;diện &lt;/span&gt;&lt;span&gt;Repository&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="140" x="300" y="385" as="geometry" />
        </mxCell>
        <mxCell id="xu6kovZ2p-w6JD-nPXKa-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="SQL" vertex="1">
          <mxGeometry height="30" width="60" x="300" y="625" as="geometry" />
        </mxCell>
        <mxCell id="xu6kovZ2p-w6JD-nPXKa-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;p class=&quot;isSelectedEnd&quot; style=&quot;&quot;&gt;&lt;strong&gt;CHÚ THÍCH&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;HTTP + JSON: giao tiếp giữa lớp trình bày và lớp nghiệp vụ.&lt;/li&gt;&lt;li&gt;Repository: giao diện truy cập dữ liệu từ lớp nghiệp vụ.&lt;/li&gt;&lt;li&gt;SQL: lớp truy cập dữ liệu thực hiện thao tác với PostgreSQL.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="150" width="250" x="560" y="40" as="geometry" />
        </mxCell>
        <mxCell id="xu6kovZ2p-w6JD-nPXKa-13" parent="1" style="text;whiteSpace=wrap;html=1;align=left;" value="&lt;p style=&quot;&quot;&gt;&lt;strong&gt;NGOÀI PHẠM VI (WON&#39;T)&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p style=&quot;&quot;&gt;Phân công kỹ thuật viên.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p style=&quot;&quot;&gt;Theo dõi tiến trình sửa chữa.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p style=&quot;&quot;&gt;Quản lý phụ tùng thay thế.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p style=&quot;&quot;&gt;Lập báo cáo ngoài luồng L02.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="170" width="230" x="40" y="909" as="geometry" />
        </mxCell>
        <mxCell id="xu6kovZ2p-w6JD-nPXKa-14" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p&gt;&lt;strong&gt;LẬP LUẬN LỰA CHỌN KIẾN TRÚC&lt;/strong&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;&lt;p&gt;Vì NFR1 yêu cầu danh sách phiếu hiển thị dưới 2 giây với 10.000 bản ghi, tôi chọn tách lớp truy cập dữ liệu qua Repository để tập trung tối ưu truy vấn và phối hợp sử dụng chỉ mục phù hợp, đánh đổi là cần duy trì thêm lớp Repository và kiểm tra hiệu năng truy vấn.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Vì NFR2 yêu cầu nhân viên tiếp nhận tạo phiếu chính xác trong dưới 3 phút, tôi chọn tách lớp trình bày khỏi lớp nghiệp vụ để giao diện tập trung vào nhập liệu, còn Service xử lý các quy tắc nghiệp vụ thống nhất, đánh đổi là phải duy trì sự nhất quán giữa giao diện và hợp đồng xử lý nghiệp vụ.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Vì NFR3 yêu cầu che số điện thoại đối với nhân viên tiếp nhận và chỉ cho phép quản lý, giám đốc xem đầy đủ, tôi chọn tập trung kiểm tra quyền truy cập và xử lý che số điện thoại tại phía máy chủ, đánh đổi là cần bổ sung kiểm thử phân quyền và xử lý dữ liệu trước khi trả phản hồi.&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="260" width="560" x="250" y="909" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
