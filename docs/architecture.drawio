        <mxCell id="xu6kovZ2p-w6JD-nPXKa-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;p class=&quot;w6asjq_TextBase _85PZeG_Text PDq2pG_selectionAnchorContainer&quot; style=&quot;text-align: justify;&quot;&gt;&lt;span class=&quot;w6asjq_TextBase _85PZeG_Text&quot;&gt;&lt;span&gt;LỚP &lt;/span&gt;&lt;span&gt;NGHIỆP &lt;/span&gt;&lt;span&gt;VỤ &lt;/span&gt;&lt;span&gt;(Business &lt;/span&gt;&lt;span&gt;/ &lt;/span&gt;&lt;span&gt;Service)&lt;/span&gt;&lt;/span&gt;&lt;span aria-hidden=&quot;true&quot; class=&quot;PDq2pG_selectionAnchor&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;w6asjq_TextBase _85PZeG_Text&quot; style=&quot;text-align: justify;&quot;&gt;- TicketService: tạo và kiểm tra phiếu bảo hành&amp;nbsp;&lt;/p&gt;&lt;p class=&quot;w6asjq_TextBase _85PZeG_Text&quot; style=&quot;text-align: justify;&quot;&gt;- ClassifyService: phân loại nhóm sự cố và mức ưu tiên&amp;nbsp;&lt;/p&gt;&lt;p class=&quot;w6asjq_TextBase _85PZeG_Text&quot; style=&quot;text-align: justify;&quot;&gt;- Áp dụng quy tắc nghiệp vụ&lt;/p&gt;" vertex="1">
